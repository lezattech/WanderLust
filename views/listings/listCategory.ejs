<% layout("layouts/bplate") %>
<% title = "WanderLust | Listings" %>

<body>

    <div class="container-fluid">
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            <% for(listing of allListings) { %>
            <div class="col">
                
                <% if(String(listing._id)===String(newListingId)) { %>
                <div class="new-listing-msg">
                    <%= newListingMsg %>
                </div>
                <%  } %>
                
                <a class="listing-link" href="/listings/<%= listing.id %>">
                    <div class="card">
                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            alt="listing_image"
                            style="height: 20rem;"
                        >

                        <div class="card-img-overlay"></div>

                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b><br>
                                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                            </p>
                        </div>
                    </div>
                </a>
                    
            </div>

            <% } %>
        </div>
    </div>
</body>
