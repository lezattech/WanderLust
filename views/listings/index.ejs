<% layout("layouts/bplate") %>
<% title = "WanderLust | Listings" %>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=star_rate_half"/>

<body>
    <div class="listing-filters">
        
        <div class="listing-filter-track">
            <div class="listing-filter">
                <a href="/listings/?search=Trednding">
                    <i class="fa-solid fa-fire"></i>
                    <p class="listing-filter-sections">Trending</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Rooms">
                    <i class="fa-solid fa-bed"></i>
                    <p class="listing-filter-sections">Rooms</p>
                </a>
                
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Beaches">
                    <i class="fa-solid fa-umbrella-beach"></i>
                    <p class="listing-filter-sections">Beaches</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=City">
                    <i class="fa-solid fa-tree-city"></i>
                    <p class="listing-filter-sections">Iconic Cities</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Farms">
                    <i class="fa-solid fa-cow"></i>
                    <p class="listing-filter-sections">Farms</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Views">
                    <i class="fa-solid fa-mountain-city"></i>
                    <p class="listing-filter-sections">Amazing Views</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Mountains">
                    <i class="fa-solid fa-mountain"></i>
                    <p class="listing-filter-sections">Mountains</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Castles">
                    <i class="fa-brands fa-fort-awesome"></i>
                    <p class="listing-filter-sections">Castles</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Pools">
                    <i class="fa-solid fa-person-swimming"></i>
                    <p class="listing-filter-sections">Pools</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Camping">
                    <i class="fa-solid fa-tents"></i>
                    <p class="listing-filter-sections">Camping</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Arctic">
                    <i class="fa-regular fa-snowflake"></i>
                    <p class="listing-filter-sections">Arctic</p>
                </a>
            </div>

            <!-- New Categories -->

            <div class="listing-filter">
                <a href="/listings/?search=Countryside">
                    <i class="fa-solid fa-house-chimney"></i>
                    <p class="listing-filter-sections">Countryside</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Lakes">
                    <i class="fa-solid fa-water"></i>
                    <p class="listing-filter-sections">Lakes</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Boats">
                    <i class="fa-solid fa-sailboat"></i>
                    <p class="listing-filter-sections">Boats</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Apartments">
                    <i class="fa-solid fa-building"></i>
                    <p class="listing-filter-sections">Apartments</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Tiny+Homes">
                    <i class="fa-solid fa-house"></i>
                    <p class="listing-filter-sections">Tiny Homes</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Historic">
                    <i class="fa-solid fa-landmark"></i>
                    <p class="listing-filter-sections">Historic</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Creative">
                    <i class="fa-solid fa-palette"></i>
                    <p class="listing-filter-sections">Creative Spaces</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Religious">
                    <i class="fa-solid fa-vihara"></i>
                    <p class="listing-filter-sections">Religious</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Vineyards">
                    <i class="fa-solid fa-wine-glass"></i>
                    <p class="listing-filter-sections">Vineyards</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Golf">
                    <i class="fa-solid fa-golf-ball-tee"></i>
                    <p class="listing-filter-sections">Golf</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Hot+Tubs">
                    <i class="fa-solid fa-hot-tub-person"></i>
                    <p class="listing-filter-sections">Hot Tubs</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Waterfront">
                    <i class="fa-solid fa-water-ladder"></i>
                    <p class="listing-filter-sections">Waterfront</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Hiking">
                    <i class="fa-solid fa-person-hiking"></i>
                    <p class="listing-filter-sections">Hiking</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Deserts">
                    <i class="fa-solid fa-sun"></i>
                    <p class="listing-filter-sections">Deserts</p>
                </a>
            </div>

            <div class="listing-filter">
                <a href="/listings/?search=Lake+House">
                    <i class="fa-solid fa-house-flood-water"></i>
                    <p class="listing-filter-sections">Lake Houses</p>
                </a>
            </div>
        </div>
    </div>
    
    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total taxes</label>
        </div>
    </div>

    <% if(noListings) { %>
    <div class="no-listing-found">
        <h1 class="no-listing-found-text">
            No listings found!
            <i class="fa-regular fa-face-sad-tear"></i>
        </h1>
    </div>
    <% } %>

    <div class="container-fluid">
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            <% for(listing of allListings) { %>
            <div class="col">
                
                <% if(String(listing._id)===String(newListingId)) { %>
                <div class="new-listing-msg">
                    <%= newListingMsg %>
                </div>
                <%  } %>
                
                <a class="listing-link" href="/listings/<%= listing.id %>">
                    <div class="card">
                        <div class="listing-image-container">
                            <img
                                src="<%= listing.image.url %>"
                                class="card-img-top"
                                alt="listing_image"
                                style="height: 20rem;"
                            >

                            <div class="card-img-overlay"></div>

                            <span class="index-star-rating-a">
                     
                                <%= listing.reviews.length
                                ? (
                                listing.reviews.reduce((sum, review) => sum + Number(review.rating), 0)
                                / listing.reviews.length
                                ).toFixed(1)
                                : "N/A"
                                %>
                          
                                
                                <span class="material-symbols-outlined index-star-rating">
                                    star_rate_half
                                </span>
                            </span>
                        </div>
                        

                        <div class="card-body">
                            <p class="card-text">
                                <span class="li-title"><%= listing.title %>
                                    
                                </span><br>
                         
                                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                                        
                             
                                <i class="tax-info tax-hidden">&nbsp;&nbsp;+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                    
            </div>

            <% } %>
        </div>
    </div>
</body>

<script src="/js/listing-filter.js"></script>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    let taxInfo = document.querySelectorAll(".tax-info");
    taxSwitch.addEventListener("click", () => {
        taxInfo.forEach((ti) => {
            ti.classList.toggle("tax-hidden");
        });
    });
</script>


