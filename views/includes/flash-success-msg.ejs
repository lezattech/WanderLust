
<link rel="stylesheet" href="/css/flash-success.css">
<% if(success && success.length) { %>
<div class="alert <%= successType %>" role="alert" id="newListingAlert">
    <%= success %>
</div>
<% } %>

<% if(error) { %>
<div class="alert <%= errorType %>" role="alert" id="newListingAlert">
    <%= error %>
</div>
<% } %>

<script src="/js/flash-msg-timeout.js"></script>

